void insert(){

    printf("Give the position to insert:");
    scanf("%d",&pos);
    for(i=n;i>pos;i--){
        arr[i]=arr[i-1];
    }
    printf("Give the value to insert: ");
    scanf("%d",&arr[pos]);
    n++;
}
void delet(){

     printf("Give the position to delete:");
     scanf("%d",&pos);
     for(i=pos;i<n;i++){
        arr[i]=arr[i+1];
    }
    n--;
}
void sort(){
    int j;
    for(i=0;i<n-1;i++){
            int mindex=i;
        for(j=i+1;j<n;j++){
            if(arr[j]<arr[mindex]){
                mindex=j;
            }
        }
        swap(&arr[i],&arr[mindex]);
    }
}

void swap(int*a,int *b){
    int temp;
    temp=*a;
    *a=*b;
    *b=temp;
}

